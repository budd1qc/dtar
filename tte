            container.innerHTML = '<div class="text-center py-8 text-slate-400"><i class="fa-solid fa-spinner fa-spin text-2xl"></i></div>';
            
            let list = [];
            if(IS_PREVIEW) { list = [...MOCK_DB.surat]; }
            else {
                const snap = await getDocs(collection(db, "surat")); // For prod, better to use orderBy and limit, but client-side app assumes small data
                snap.forEach(d => list.push({id: d.id, ...d.data()}));
            }

            list = list.filter(s => {
                const matchSearch = s.nomorSurat.toLowerCase().includes(search) || s.keterangan.toLowerCase().includes(search);
                const matchFilter = filter === 'all' ? true : s.status === filter;
                return matchSearch && matchFilter;
            });
            
            // Logika Sorting Terbaru/Terlama
            list.sort((a, b) => {
                const timeA = typeof a.createdAt === 'object' && a.createdAt !== null ? (a.createdAt.toMillis ? a.createdAt.toMillis() : 0) : (a.createdAt || 0);
                const timeB = typeof b.createdAt === 'object' && b.createdAt !== null ? (b.createdAt.toMillis ? b.createdAt.toMillis() : 0) : (b.createdAt || 0);
                return sortOrder === 'terbaru' ? timeB - timeA : timeA - timeB;
            });
            
            if(list.length === 0) { container.innerHTML = '<div class="text-center py-8 text-slate-500 bg-white rounded-2xl border border-slate-200">Tidak ada surat ditemukan.</div>'; return; }
            
            container.innerHTML = list.map(s => `
                <div class="glass p-5 rounded-2xl flex flex-col md:flex-row items-start md:items-center justify-between gap-4 border-l-4 ${s.status==='Selesai'?'border-green-500':'border-orange-400'} transition-transform hover:-translate-y-1">
                    <div class="flex-1">
                        <div class="flex items-center gap-2 mb-1">
                            <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold ${s.status==='Selesai'?'bg-green-100 text-green-600':'bg-orange-100 text-orange-600'} uppercase tracking-wider">${s.status}</span>
                            <span class="text-xs text-slate-400"><i class="fa-regular fa-calendar mr-1"></i> ${s.tanggal}</span>
                        </div>
                        <h4 class="font-bold text-slate-800 text-lg">${s.nomorSurat}</h4>
                        <p class="text-sm text-slate-500 mt-1 line-clamp-1">${s.keterangan}</p>
                    </div>
                    <button onclick="showDetailSurat('${s.id}')" class="w-full md:w-auto px-5 py-2 rounded-xl text-primary bg-orange-50 hover:bg-primary hover:text-white transition-colors font-medium border border-orange-100">
                        Lihat Detail <i class="fa-solid fa-arrow-right ml-1"></i>
                    </button>
                </div>
            `).join('');
        }

        window.showCreateSurat = async () => {
            // Load pengurus options
            const pList = document.getElementById('cs-pengurus-list');
            pList.innerHTML = '<p class="text-xs text-slate-400">Memuat...</p>';
            
            let pengurus = [];
            if(IS_PREVIEW) { pengurus = [...MOCK_DB.pengurus]; }
            else {
                const snap = await getDocs(collection(db, "pengurus"));
                snap.forEach(d => pengurus.push({id: d.id, ...d.data()}));
            }
            
            if(pengurus.length === 0) pList.innerHTML = '<p class="text-sm text-red-500">Data Pengurus kosong. Tambahkan pengurus terlebih dahulu.</p>';
            else {
                pList.innerHTML = pengurus.map(p => `
                    <label class="flex items-center gap-3 p-3 bg-white border border-slate-100 rounded-lg cursor-pointer hover:border-primary transition-colors">
                        <input type="checkbox" name="cs-penandatangan" value="${p.id}" data-nama="${p.namaLengkap}" data-jabatan="${p.jabatan}" class="w-4 h-4 text-primary rounded focus:ring-primary">
                        <div>
                            <p class="font-medium text-slate-700 text-sm">${p.namaLengkap}</p>
                            <p class="text-xs text-slate-400">${p.jabatan}</p>
                        </div>
                    </label>
                `).join('');
            }
            
            // Reset Form
            document.getElementById('form-create-surat').reset();
            // Show View
            document.querySelectorAll('.admin-view').forEach(el => el.classList.add('hidden'));
            document.getElementById('view-surat-create').classList.remove('hidden');
        }

        document.getElementById('form-create-surat').addEventListener('submit', async (e) => {
            e.preventDefault();
            const checked = document.querySelectorAll('input[name="cs-penandatangan"]:checked');
            if(checked.length === 0) { showToast("Pilih minimal 1 penandatangan!", true); return; }

            const suratData = {
                nomorSurat: document.getElementById('cs-no').value,
                tanggal: document.getElementById('cs-tgl').value,
                keterangan: document.getElementById('cs-ket').value,
                linkDokumen: document.getElementById('cs-link').value,
                status: 'Menunggu',
                createdAt: IS_PREVIEW ? Date.now() : serverTimestamp()
            };

            showLoader("Membuat Surat & Link TTD...");
            try {
                let suratId;
                if(IS_PREVIEW) {
                    suratId = 'SRT_' + Date.now();
                    MOCK_DB.surat.push({...suratData, id: suratId});
                } else {
                    const sRef = await addDoc(collection(db, "surat"), suratData);
                    suratId = sRef.id;
                }

                // Create Tugas TTD
                for (let box of checked) {
                    const tugasData = {
                        suratId: suratId,
                        pengurusId: box.value,
                        namaPengurus: box.getAttribute('data-nama'),
                        jabatanPengurus: box.getAttribute('data-jabatan'),
                        status: 'Pending',
                        gambarTTD: null
                    };
                    if(IS_PREVIEW) { MOCK_DB.tugas_ttd.push({...tugasData, id: 'TGS_'+Date.now()+Math.random()}); }
                    else { await addDoc(collection(db, "tugas_ttd"), tugasData); }
                }

                hideLoader(); showToast("Surat berhasil dibuat!");
                navigateAdmin('surat');
            } catch(error) {
                hideLoader(); showToast("Gagal membuat surat.", true); console.error(error);
            }
        });

        window.showDetailSurat = async (id) => {
            globalSuratIdForDetail = id;
            showLoader("Memuat detail...");
            let surat = null, tugas = [];
            
            if(IS_PREVIEW) {
                surat = MOCK_DB.surat.find(s=>s.id===id);
                tugas = MOCK_DB.tugas_ttd.filter(t=>t.suratId===id);
            } else {
                const sDoc = await getDoc(doc(db, "surat", id));
                if(sDoc.exists()) surat = {id: sDoc.id, ...sDoc.data()};
                
                const q = query(collection(db, "tugas_ttd"), where("suratId", "==", id));
                const tSnap = await getDocs(q);
                tSnap.forEach(d => tugas.push({id: d.id, ...d.data()}));
            }
            hideLoader();

            if(!surat) return showToast("Surat tidak ditemukan", true);

            // Populate Info
            document.getElementById('ds-no').innerText = surat.nomorSurat;
            document.getElementById('ds-tgl').innerText = surat.tanggal;
            document.getElementById('ds-ket').innerText = surat.keterangan;
            document.getElementById('ds-link').href = surat.linkDokumen;
            const stEl = document.getElementById('ds-status');
            stEl.innerText = surat.status;
            stEl.className = `px-3 py-1 rounded-full text-xs font-bold mb-2 inline-block ${surat.status==='Selesai'?'bg-green-100 text-green-600':'bg-orange-100 text-orange-600'}`;

            // Populate TTD List
            const listEl = document.getElementById('ds-ttd-list');
            listEl.innerHTML = tugas.map(t => {
                const isSigned = t.status === 'Signed';
                const link = `${window.location.origin}${window.location.pathname}?sign=${t.id}`;
                
                // Teks pengantar untuk WhatsApp
                const waText = encodeURIComponent(`Halo Bapak/Ibu ${t.namaPengurus},\n\nMohon kesediaannya untuk menandatangani dokumen surat secara digital sebagai ${t.jabatanPengurus}.\n\nSilakan klik tautan berikut untuk melihat dan menandatangani dokumen:\n${link}\n\nTerima kasih.`);
                
                return `
                <div class="bg-white border border-slate-100 rounded-2xl p-4 flex flex-col justify-between shadow-sm relative overflow-hidden">
                    ${isSigned ? `<div class="absolute top-0 right-0 w-16 h-16 bg-green-50 rounded-bl-full z-0"></div><i class="fa-solid fa-check text-green-400 absolute top-3 right-3 z-0"></i>` : ''}
                    <div class="relative z-10">
                        <p class="font-bold text-slate-800">${t.namaPengurus}</p>
                        <p class="text-xs text-slate-500 mb-3">${t.jabatanPengurus}</p>
                        ${isSigned ? 
                            `<div class="border border-dashed border-slate-200 rounded-lg p-2 bg-slate-50 flex items-center justify-center h-20 mb-2">
                                <img src="${t.gambarTTD}" class="max-h-full object-contain">
                             </div>
                             <span class="text-xs font-medium text-green-600"><i class="fa-solid fa-check-circle mr-1"></i> Telah Ditandatangani</span>
                             <p class="text-[10px] text-slate-400 mt-1"><i class="fa-regular fa-clock mr-1"></i> ${formatTanggalTTD(t.signedAt)}</p>` 
                            : 
                            `<div class="flex items-center gap-2 mb-2"><span class="w-2 h-2 rounded-full bg-orange-400 animate-pulse"></span> <span class="text-xs text-orange-500 font-medium">Menunggu Tanda Tangan</span></div>
                             <div class="flex gap-2">
                                 <button onclick="copyToClipboard('${link}')" class="flex-1 text-xs bg-slate-100 hover:bg-slate-200 text-slate-700 py-2 rounded-lg font-medium transition-colors flex items-center justify-center">
                                    <i class="fa-solid fa-copy mr-1"></i> Copy
                                 </button>
                                 <a href="https://api.whatsapp.com/send?text=${waText}" target="_blank" class="flex-1 text-xs bg-green-500 hover:bg-green-600 text-white py-2 rounded-lg font-medium transition-colors flex items-center justify-center">
                                    <i class="fa-brands fa-whatsapp mr-1 text-sm"></i> Share WA
                                 </a>
                             </div>`
                        }
                    </div>
                </div>
                `;
            }).join('');

            // Show View
            document.querySelectorAll('.admin-view').forEach(el => el.classList.add('hidden'));
            document.getElementById('view-surat-detail').classList.remove('hidden');
        }

        // Utils for Share/Copy
        window.copyToClipboard = (text) => {
            navigator.clipboard.writeText(text).then(()=>{ showToast("Link disalin!"); }).catch(()=>{showToast("Gagal salin link", true)});
        }
        
        window.getPublicVerifyLink = () => { return `${window.location.origin}${window.location.pathname}?verify=${globalSuratIdForDetail}`; }
        window.copyPublicVerifyLink = () => { copyToClipboard(getPublicVerifyLink()); }
        
        window.showQRCode = () => {
            document.getElementById('qrcode-container').innerHTML = ''; // Clear old
            new QRCode(document.getElementById('qrcode-container'), {
                text: window.getPublicVerifyLink(),
                width: 200, height: 200,
                colorDark : "#0f172a", colorLight : "#ffffff", correctLevel : QRCode.CorrectLevel.H
            });
            document.getElementById('modal-qr').classList.remove('hidden');
        }
        window.closeQRCode = () => { document.getElementById('modal-qr').classList.add('hidden'); }

        // Format tanggal TTD (mendukung Firestore Timestamp maupun angka ms mode preview)
        window.formatTanggalTTD = (ts) => {
            if(!ts) return '-';
            let d;
            if(typeof ts === 'object' && ts !== null && typeof ts.toDate === 'function') { d = ts.toDate(); }
            else { d = new Date(ts); }
            if(isNaN(d.getTime())) return '-';
            return d.toLocaleString('id-ID', { day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' });
        }

        // Edit Surat
        window.openEditSurat = async () => {
            if(!globalSuratIdForDetail) return;
            let surat = null;
            if(IS_PREVIEW) { surat = MOCK_DB.surat.find(s=>s.id===globalSuratIdForDetail); }
            else { const sDoc = await getDoc(doc(db, "surat", globalSuratIdForDetail)); if(sDoc.exists()) surat = {id: sDoc.id, ...sDoc.data()}; }
            if(!surat) return showToast("Surat tidak ditemukan", true);

            document.getElementById('es-id').value = surat.id;
            document.getElementById('es-no').value = surat.nomorSurat;
            document.getElementById('es-tgl').value = surat.tanggal;
            document.getElementById('es-ket').value = surat.keterangan;
            document.getElementById('es-link').value = surat.linkDokumen;
            document.getElementById('modal-edit-surat').classList.remove('hidden');
        }
        window.closeModalEditSurat = () => document.getElementById('modal-edit-surat').classList.add('hidden');

        document.getElementById('form-edit-surat').addEventListener('submit', async (e) => {
            e.preventDefault();
            const id = document.getElementById('es-id').value;
            const data = {
                nomorSurat: document.getElementById('es-no').value,
                tanggal: document.getElementById('es-tgl').value,
                keterangan: document.getElementById('es-ket').value,
                linkDokumen: document.getElementById('es-link').value
            };
            showLoader("Menyimpan perubahan...");
            if(IS_PREVIEW) {
                const i = MOCK_DB.surat.findIndex(s=>s.id===id);
                if(i>-1) MOCK_DB.surat[i] = {...MOCK_DB.surat[i], ...data};
            } else {
                try { await updateDoc(doc(db, "surat", id), data); }
                catch(e) { showToast("Gagal menyimpan perubahan", true); hideLoader(); return; }
            }
            hideLoader(); closeModalEditSurat(); showToast("Surat berhasil diperbarui!");
            showDetailSurat(id);
        });

        // Hapus Surat (beserta seluruh tugas TTD terkait)
        window.deleteSurat = async () => {
            if(!globalSuratIdForDetail) return;
            if(!confirm("Hapus surat ini beserta seluruh data tanda tangannya? Tindakan ini tidak dapat dibatalkan.")) return;
            const id = globalSuratIdForDetail;
            showLoader("Menghapus surat...");
            try {
                if(IS_PREVIEW) {
                    MOCK_DB.surat = MOCK_DB.surat.filter(s=>s.id!==id);
                    MOCK_DB.tugas_ttd = MOCK_DB.tugas_ttd.filter(t=>t.suratId!==id);
                } else {
                    const q = query(collection(db, "tugas_ttd"), where("suratId", "==", id));
                    const snap = await getDocs(q);
                    for (const d of snap.docs) { await deleteDoc(doc(db, "tugas_ttd", d.id)); }
                    await deleteDoc(doc(db, "surat", id));
                }
                hideLoader(); showToast("Surat berhasil dihapus!");
                navigateAdmin('surat');
            } catch(e) { hideLoader(); showToast("Gagal menghapus surat", true); console.error(e); }
        }

        // ==========================================
        // 7. PUBLIC FRONTEND (E-SIGNATURE)
        // ==========================================
        let currentTugasToken = null;
        let signSuratId = null;

        async function initPublicSign(tokenId) {
            hideAllScreens();
            document.getElementById('public-screen').style.display = 'flex';
            document.getElementById('public-view-sign').classList.remove('hidden');
            showLoader("Mengecek Akses Tanda Tangan...");
            
            try {
                let tugas = null, surat = null;
                if(IS_PREVIEW) {
                    tugas = MOCK_DB.tugas_ttd.find(t=>t.id===tokenId);
                    if(tugas) surat = MOCK_DB.surat.find(s=>s.id===tugas.suratId);
                } else {
                    const tDoc = await getDoc(doc(db, "tugas_ttd", tokenId));
                    if(tDoc.exists()) { tugas = {id: tDoc.id, ...tDoc.data()}; const sDoc = await getDoc(doc(db, "surat", tugas.suratId)); if(sDoc.exists()) surat = {id: sDoc.id, ...sDoc.data()}; }
                }

                hideLoader();
                if(!tugas || !surat) {
                    document.getElementById('public-view-sign').innerHTML = `<div class="text-center p-8"><i class="fa-solid fa-triangle-exclamation text-4xl text-red-500 mb-4"></i><h2 class="text-xl font-bold">Link Tidak Valid</h2><p class="text-slate-500 mt-2">Permintaan tanda tangan tidak ditemukan atau link salah.</p></div>`;
                    return;
                }

                currentTugasToken = tugas.id;
                signSuratId = surat.id;

                // Bind Data
                document.getElementById('pub-sign-nama').innerText = `Halo, ${tugas.namaPengurus}`;
                document.getElementById('pub-sign-jabatan').innerText = tugas.jabatanPengurus;
                document.getElementById('pub-sign-nosurat').innerText = surat.nomorSurat;
                document.getElementById('pub-sign-ket').innerText = surat.keterangan;
                document.getElementById('pub-sign-btn-doc').href = surat.linkDokumen; // BUTTON LINK BINDING

                if(tugas.status === 'Signed') {
                    document.getElementById('signature-section').style.display = 'none';
                    document.getElementById('signature-done-msg').style.display = 'block';
                    document.getElementById('signature-done-msg').querySelector('p').innerText = "Dokumen ini sudah Anda tandatangani sebelumnya. Link ini tidak dapat digunakan lagi untuk menandatangani ulang.";
                } else {
                    // Init Canvas
                    const canvas = document.getElementById('signature-pad');
                    // Resize logic for high DPI / Responsiveness
                    const resizeCanvas = () => { 
                        const ratio =  Math.max(window.devicePixelRatio || 1, 1); 
                        canvas.width = canvas.offsetWidth * ratio; 
                        canvas.height = canvas.offsetHeight * ratio; 
                        canvas.getContext("2d").scale(ratio, ratio); 
                        if(signaturePad) signaturePad.clear();
                    };
                    window.addEventListener("resize", resizeCanvas);
                    resizeCanvas();
                    signaturePad = new SignaturePad(canvas, { penColor: 'rgb(15, 23, 42)' }); // dark slate color
                }
            } catch(e) { hideLoader(); console.error(e); }
        }

        window.clearSignature = () => { if(signaturePad) signaturePad.clear(); }
        window.submitSignature = async () => {
            if(signaturePad.isEmpty()) { showToast("Silakan gambar tanda tangan Anda dulu", true); return; }
            
            const dataURL = signaturePad.toDataURL(); // Base64 Image
            showLoader("Menyimpan Tanda Tangan...");
            
            try {
                if(IS_PREVIEW) {
                    const idx = MOCK_DB.tugas_ttd.findIndex(t=>t.id===currentTugasToken);
                    if(idx>-1) { MOCK_DB.tugas_ttd[idx].status = 'Signed'; MOCK_DB.tugas_ttd[idx].gambarTTD = dataURL; MOCK_DB.tugas_ttd[idx].signedAt = Date.now(); }
                    checkAndUpdateSuratStatusPreview(signSuratId);
                } else {
                    // Update Token
                    await updateDoc(doc(db, "tugas_ttd", currentTugasToken), { status: 'Signed', gambarTTD: dataURL, signedAt: serverTimestamp() });
                    // Check Completion
                    const q = query(collection(db, "tugas_ttd"), where("suratId", "==", signSuratId));
                    const snap = await getDocs(q);
                    let allSigned = true;
                    snap.forEach(d => { if(d.data().status !== 'Signed') allSigned = false; });
                    
                    if(allSigned) { await updateDoc(doc(db, "surat", signSuratId), { status: 'Selesai' }); }
                }

                hideLoader();
                document.getElementById('signature-section').style.display = 'none';
                document.getElementById('signature-done-msg').style.display = 'block';
            } catch(e) { hideLoader(); showToast("Gagal menyimpan", true); console.error(e); }
        }

        function checkAndUpdateSuratStatusPreview(suratId) {
            const allTugas = MOCK_DB.tugas_ttd.filter(t=>t.suratId === suratId);
            const allSigned = allTugas.every(t=>t.status === 'Signed');
            if(allSigned) { const idx = MOCK_DB.surat.findIndex(s=>s.id === suratId); if(idx>-1) MOCK_DB.surat[idx].status = 'Selesai'; }
        }

        // ==========================================
        // 8. PUBLIC FRONTEND (VERIFIKASI)
        // ==========================================
        async function initPublicVerify(suratId) {
            hideAllScreens();
            document.getElementById('public-screen').style.display = 'flex';
            document.getElementById('public-view-verify').classList.remove('hidden');
            showLoader("Memvalidasi Dokumen...");
            
            try {
                let surat = null, tugas = [];
                if(IS_PREVIEW) {
                    surat = MOCK_DB.surat.find(s=>s.id===suratId);
                    tugas = MOCK_DB.tugas_ttd.filter(t=>t.suratId===suratId);
                } else {
                    const sDoc = await getDoc(doc(db, "surat", suratId));
                    if(sDoc.exists()) surat = {id: sDoc.id, ...sDoc.data()};
                    const q = query(collection(db, "tugas_ttd"), where("suratId", "==", suratId));
                    const tSnap = await getDocs(q);
                    tSnap.forEach(d => tugas.push({id: d.id, ...d.data()}));
                }

                hideLoader();
                if(!surat) {
                    document.getElementById('public-view-verify').innerHTML = `<div class="text-center p-8"><i class="fa-solid fa-circle-xmark text-4xl text-red-500 mb-4"></i><h2 class="text-xl font-bold">Dokumen Tidak Ditemukan</h2><p class="text-slate-500 mt-2">Pastikan link atau QR code valid.</p></div>`;
                    return;
                }

                // Bind Data
                const st = document.getElementById('pub-ver-status');
                st.innerText = surat.status === 'Selesai' ? 'SAH & SELESAI DITANDATANGANI' : 'MASIH DALAM PROSES (MENUNGGU)';
                st.className = `py-2 font-bold ${surat.status === 'Selesai' ? 'text-green-600' : 'text-orange-500'}`;
                
                document.getElementById('pub-ver-no').innerText = surat.nomorSurat;
                document.getElementById('pub-ver-tgl').innerText = surat.tanggal;
                document.getElementById('pub-ver-ket').innerText = surat.keterangan;
                document.getElementById('pub-ver-btn-doc').href = surat.linkDokumen;

                // Render TTD
                const ttdList = document.getElementById('pub-ver-ttd-list');
                ttdList.innerHTML = tugas.map(t => {
                    const isSigned = t.status === 'Signed';
                    return `
                    <div class="flex items-center justify-between p-3 border border-slate-100 rounded-xl bg-white shadow-sm">
                        <div>
                            <p class="font-bold text-slate-800 text-sm">${t.namaPengurus}</p>
                            <p class="text-xs text-slate-500">${t.jabatanPengurus}</p>
                        </div>
                        <div class="text-right">
                            ${isSigned ? 
                                `<div class="h-12 w-24 border border-slate-100 rounded bg-slate-50 overflow-hidden flex justify-center ml-auto mb-1"><img src="${t.gambarTTD}" class="h-full object-contain"></div>
                                 <span class="text-[10px] font-bold text-green-600 uppercase tracking-wider"><i class="fa-solid fa-check mr-1"></i>Signed</span>`
                                : 
                                `<div class="h-12 w-24 flex items-center justify-center ml-auto"><i class="fa-solid fa-clock-rotate-left text-slate-300 text-2xl"></i></div>
                                 <span class="text-[10px] font-bold text-orange-400 uppercase tracking-wider">Menunggu</span>`
                            }
                        </div>
                    </div>
                    `;
                }).join('');

            } catch(e) { hideLoader(); console.error(e); }
        }

        // ==========================================
        // MOCK DATABASE ENGINE (UNTUK PREVIEW)
        // ==========================================
        const MOCK_DB = {
            pengurus: [],
            surat: [],
            tugas_ttd: []
        };
        function mockFirebaseEngine() { console.log("Mock Engine Loaded."); }

    </script>
</body></div>
</html>
