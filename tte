<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Dtar E-Signature</title>
    <!-- PWA Manifest & Icons (Injected via JS) -->
    <link id="pwa-manifest" rel="manifest" href="">
    <meta name="theme-color" content="#f97316">
    <link rel="apple-touch-icon" href="https://via.placeholder.com/192x192.png?text=Dtar+Icon">
    
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- QRCode.js -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
    <!-- Signature Pad -->
    <script src="https://cdn.jsdelivr.net/npm/signature_pad@4.1.5/dist/signature_pad.umd.min.js"></script>

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: { primary: '#f97316', primaryDark: '#ea580c', primaryLight: '#fdba74' }
                }
            }
        }
    </script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap');
        body { font-family: 'Inter', sans-serif; background-color: #f8fafc; margin: 0; padding: 0; overflow-x: hidden; }
         #dtar-app-container {
            position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; 
            z-index: 999999999; background-color: #f9fafb; overflow-y: auto; overflow-x: hidden;
        }
        /* Glassmorphism Classes */
        .glass {
            background: rgba(255, 255, 255, 0.85);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.5);
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05), 0 2px 4px -1px rgba(0, 0, 0, 0.03);
        }
        .glass-primary {
            background: rgba(249, 115, 22, 0.1);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(249, 115, 22, 0.2);
        }
        
        /* Signature Canvas */
        .signature-pad-wrapper {
            position: relative; width: 100%; height: 250px; background-color: white; 
            border: 2px dashed #cbd5e1; border-radius: 0.5rem; overflow: hidden;
        }
        .signature-pad-wrapper canvas { position: absolute; left: 0; top: 0; width: 100%; height: 100%; cursor: crosshair;}

        /* Scrollbar styling */
        ::-webkit-scrollbar { width: 6px; height: 6px; }
        ::-webkit-scrollbar-track { background: transparent; }
        ::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 10px; }
        ::-webkit-scrollbar-thumb:hover { background: #94a3b8; }

        /* Loader */
        .loader { border: 3px solid #f3f3f3; border-top: 3px solid #f97316; border-radius: 50%; width: 24px; height: 24px; animation: spin 1s linear infinite; }
        @keyframes spin { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }

        /* Layout & Responsiveness */
      /* Semua screen disembunyikan secara default. JavaScript akan menentukan screen mana yang ditampilkan. */
      #login-screen, 
      #admin-layout, 
      #public-screen 
      { display: none; }

        /* Bottom Nav Fix for iOS */
        .pb-safe { padding-bottom: env(safe-area-inset-bottom); }
    </style>
  
  <script> /* * EARLY ROUTING * ----------------------------- * Dibaca sedini mungkin sebelum Firebase * dan script aplikasi selesai dimuat. * * Tujuan: * ?sign=TOKEN -> public screen * ?verify=ID -> public screen * tanpa transit ke login screen. */ (function () { const params = new URLSearchParams(window.location.search); const hasSign = params.has('sign') && params.get('sign'); const hasVerify = params.has('verify') && params.get('verify'); if (hasSign || hasVerify) { document.documentElement.classList.add('public-route'); } else { document.documentElement.classList.add('admin-route'); } })(); </script>
<style> /* Pastikan route publik tidak pernah menampilkan login/admin */ html.public-route #login-screen, html.public-route #admin-layout { display: none !important; } /* Login tetap tersembunyi sampai auth selesai */ html.admin-route #login-screen, html.admin-route #admin-layout { display: none; } </style>
  
</head>
  <div id="dtar-app-container"> 
<body class="text-slate-800 antialiased h-screen flex flex-col">

    <!-- Global Loading Overlay -->
    <div id="global-loader" class="fixed inset-0 bg-white/90 z-50 flex flex-col items-center justify-center hidden">
        <div class="loader mb-4" style="width: 50px; height: 50px;"></div>
        <p class="text-primary font-medium" id="loader-text">Memuat Data...</p>
    </div>

    <!-- NOTIFICATION TOAST -->
    <div id="toast" class="fixed top-5 left-1/2 transform -translate-x-1/2 px-6 py-3 rounded-full shadow-lg z-[100] hidden transition-all duration-300 opacity-0 font-medium text-sm text-center min-w-[200px]"></div>

    <!-- 1. LOGIN SCREEN -->
    <div id="login-screen" class="min-h-screen w-full items-center justify-center bg-gradient-to-br from-orange-50 to-orange-100 p-4">
        <div class="glass p-8 rounded-3xl w-full max-w-md shadow-2xl relative overflow-hidden">
            <div class="absolute top-[-50px] right-[-50px] w-32 h-32 bg-primary rounded-full opacity-20 blur-2xl"></div>
            <div class="absolute bottom-[-50px] left-[-50px] w-32 h-32 bg-orange-400 rounded-full opacity-20 blur-2xl"></div>
            
            <div class="text-center mb-8 relative z-10">
                <div class="w-16 h-16 bg-gradient-to-tr from-primary to-orange-400 rounded-2xl mx-auto flex items-center justify-center shadow-lg mb-4">
                    <i class="fa-solid fa-signature text-3xl text-white"></i>
                </div>
                <h1 class="text-2xl font-bold text-gray-800 tracking-tight">Dtar E-Signature</h1>
                <p class="text-sm text-gray-500 mt-1">Sistem Penandatanganan Digital</p>
            </div>

            <form id="login-form" class="space-y-5 relative z-10">
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Email Admin</label>
                    <div class="relative">
                        <i class="fa-solid fa-envelope absolute left-3 top-1/2 transform -translate-y-1/2 text-gray-400"></i>
                        <input type="email" id="login-email" required class="w-full pl-10 pr-4 py-3 rounded-xl border border-gray-200 focus:ring-2 focus:ring-primary focus:border-transparent outline-none bg-white/50 transition-all" placeholder="admin@dtar.com">
                    </div>
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Kata Sandi</label>
                    <div class="relative">
                        <i class="fa-solid fa-lock absolute left-3 top-1/2 transform -translate-y-1/2 text-gray-400"></i>
                        <input type="password" id="login-password" required class="w-full pl-10 pr-4 py-3 rounded-xl border border-gray-200 focus:ring-2 focus:ring-primary focus:border-transparent outline-none bg-white/50 transition-all" placeholder="••••••••">
                    </div>
                </div>
                <button type="submit" class="w-full bg-primary hover:bg-primaryDark text-white font-semibold py-3 rounded-xl shadow-lg shadow-orange-200 transition-all active:scale-95 flex justify-center items-center gap-2">
                    Masuk Dashboard <i class="fa-solid fa-arrow-right"></i>
                </button>
            </form>
        </div>
    </div>

    <!-- 2. ADMIN LAYOUT -->
    <div id="admin-layout" class="h-screen w-full bg-slate-50 flex overflow-hidden">
        
        <!-- Desktop Sidebar -->
        <aside class="hidden md:flex flex-col w-64 bg-white border-r border-slate-200 z-20 h-full shadow-sm">
            <div class="p-6 flex items-center gap-3 border-b border-slate-100">
                <div class="w-8 h-8 bg-primary rounded-lg flex items-center justify-center">
                    <i class="fa-solid fa-signature text-white text-sm"></i>
                </div>
                <span class="font-bold text-lg text-slate-800">Dtar E-Sign</span>
            </div>
            <nav class="flex-1 p-4 space-y-2 overflow-y-auto">
                <a href="#" onclick="navigateAdmin('dashboard')" id="nav-desktop-dashboard" class="nav-item flex items-center gap-3 px-4 py-3 rounded-xl text-slate-500 hover:bg-orange-50 hover:text-primary transition-colors font-medium">
                    <i class="fa-solid fa-house w-5"></i> Dashboard
                </a>
                <a href="#" onclick="navigateAdmin('surat')" id="nav-desktop-surat" class="nav-item flex items-center gap-3 px-4 py-3 rounded-xl text-slate-500 hover:bg-orange-50 hover:text-primary transition-colors font-medium">
                    <i class="fa-solid fa-file-signature w-5"></i> Manajemen Surat
                </a>
                <a href="#" onclick="navigateAdmin('pengurus')" id="nav-desktop-pengurus" class="nav-item flex items-center gap-3 px-4 py-3 rounded-xl text-slate-500 hover:bg-orange-50 hover:text-primary transition-colors font-medium">
                    <i class="fa-solid fa-users w-5"></i> Data Pengurus
                </a>
            </nav>
            <div class="p-4 border-t border-slate-100">
                <button onclick="logoutApp()" class="w-full flex items-center justify-center gap-2 px-4 py-2 rounded-xl text-red-500 hover:bg-red-50 transition-colors font-medium">
                    <i class="fa-solid fa-right-from-bracket"></i> Keluar
                </button>
            </div>
        </aside>

        <!-- Main Content Area -->
        <main class="flex-1 flex flex-col h-full relative overflow-hidden pb-16 md:pb-0">
            <!-- Mobile Header -->
            <header class="md:hidden glass flex items-center justify-between p-4 sticky top-0 z-30">
                <div class="flex items-center gap-2">
                    <div class="w-8 h-8 bg-primary rounded-lg flex items-center justify-center">
                        <i class="fa-solid fa-signature text-white text-sm"></i>
                    </div>
                    <span class="font-bold text-lg text-slate-800">Dtar E-Sign</span>
                </div>
                <button onclick="logoutApp()" class="w-8 h-8 flex items-center justify-center text-red-500 bg-red-50 rounded-full">
                    <i class="fa-solid fa-power-off"></i>
                </button>
            </header>

            <!-- Scrollable Content -->
            <div class="flex-1 overflow-y-auto p-4 md:p-8 scroll-smooth" id="main-scroll-area">
                
                <!-- View: Dashboard -->
                <div id="view-dashboard" class="admin-view hidden space-y-6">
                    <div>
                        <h2 class="text-2xl font-bold text-slate-800">Dashboard</h2>
                        <p class="text-slate-500">Ringkasan statistik penandatanganan elektronik.</p>
                    </div>
                    
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                        <div class="glass p-5 rounded-2xl flex items-center gap-4">
                            <div class="w-12 h-12 bg-blue-100 text-blue-500 rounded-xl flex items-center justify-center text-xl">
                                <i class="fa-solid fa-envelope"></i>
                            </div>
                            <div>
                                <p class="text-sm text-slate-500 font-medium">Total Surat</p>
                                <p class="text-2xl font-bold text-slate-800" id="stat-total">0</p>
                            </div>
                        </div>
                        <div class="glass p-5 rounded-2xl flex items-center gap-4">
                            <div class="w-12 h-12 bg-orange-100 text-orange-500 rounded-xl flex items-center justify-center text-xl">
                                <i class="fa-solid fa-clock-rotate-left"></i>
                            </div>
                            <div>
                                <p class="text-sm text-slate-500 font-medium">Menunggu TTD</p>
                                <p class="text-2xl font-bold text-slate-800" id="stat-pending">0</p>
                            </div>
                        </div>
                        <div class="glass p-5 rounded-2xl flex items-center gap-4">
                            <div class="w-12 h-12 bg-green-100 text-green-500 rounded-xl flex items-center justify-center text-xl">
                                <i class="fa-solid fa-check-double"></i>
                            </div>
                            <div>
                                <p class="text-sm text-slate-500 font-medium">Surat Selesai</p>
                                <p class="text-2xl font-bold text-slate-800" id="stat-selesai">0</p>
                            </div>
                        </div>
                    </div>

                    <div class="glass p-6 rounded-2xl text-center md:text-left flex flex-col md:flex-row items-center justify-between gap-4 border-l-4 border-primary">
                        <div>
                            <h3 class="font-bold text-lg text-slate-800">Buat Surat Baru</h3>
                            <p class="text-sm text-slate-500">Mulai proses penandatanganan dokumen baru sekarang.</p>
                        </div>
                        <button onclick="showCreateSurat()" class="bg-primary hover:bg-primaryDark text-white px-6 py-2.5 rounded-xl font-medium shadow-md transition-all active:scale-95 whitespace-nowrap">
                            <i class="fa-solid fa-plus mr-2"></i> Buat Surat
                        </button>
                    </div>
                </div>

                <!-- View: Manajemen Surat -->
                <div id="view-surat" class="admin-view hidden space-y-6">
                    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
                        <div>
                            <h2 class="text-2xl font-bold text-slate-800">Manajemen Surat</h2>
                            <p class="text-slate-500">Kelola dan pantau status dokumen.</p>
                        </div>
                        <button onclick="showCreateSurat()" class="bg-primary text-white px-4 py-2 rounded-xl font-medium shadow-md hover:bg-primaryDark flex items-center justify-center gap-2">
                            <i class="fa-solid fa-plus"></i> Surat Baru
                        </button>
                    </div>

                    <div class="glass p-4 rounded-2xl flex flex-col md:flex-row gap-3">
                        <div class="relative flex-1">
                            <i class="fa-solid fa-search absolute left-3 top-1/2 transform -translate-y-1/2 text-slate-400"></i>
                            <input type="text" id="search-surat" onkeyup="renderSuratList()" placeholder="Cari No. Surat / Keterangan..." class="w-full pl-10 pr-4 py-2 bg-slate-50 border border-slate-200 rounded-xl outline-none focus:ring-2 focus:ring-primary text-sm">
                        </div>
                        <div class="flex gap-2 w-full md:w-auto">
                            <select id="sort-surat" onchange="renderSuratList()" class="flex-1 md:flex-none bg-slate-50 border border-slate-200 rounded-xl px-4 py-2 outline-none focus:ring-2 focus:ring-primary text-sm">
                                <option value="terbaru">Terbaru</option>
                                <option value="terlama">Terlama</option>
                            </select>
                            <select id="filter-surat" onchange="renderSuratList()" class="flex-1 md:flex-none bg-slate-50 border border-slate-200 rounded-xl px-4 py-2 outline-none focus:ring-2 focus:ring-primary text-sm">
                                <option value="all">Semua Status</option>
                                <option value="Menunggu">Menunggu</option>
                                <option value="Selesai">Selesai</option>
                            </select>
                        </div>
                    </div>

                    <div class="grid grid-cols-1 gap-4" id="surat-list-container">
                        <!-- Surat Items injected by JS -->
                    </div>
                </div>

                <!-- View: Buat Surat Baru (Form) -->
                <div id="view-surat-create" class="admin-view hidden space-y-6">
                    <div class="flex items-center gap-3">
                        <button onclick="navigateAdmin('surat')" class="w-10 h-10 flex items-center justify-center bg-white rounded-xl shadow-sm text-slate-500 hover:text-primary">
                            <i class="fa-solid fa-arrow-left"></i>
                        </button>
                        <h2 class="text-2xl font-bold text-slate-800">Buat Surat Baru</h2>
                    </div>

                    <form id="form-create-surat" class="glass p-6 rounded-2xl space-y-5">
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                            <div>
                                <label class="block text-sm font-medium text-slate-700 mb-1">Nomor Surat <span class="text-red-500">*</span></label>
                                <input type="text" id="cs-no" required class="w-full px-4 py-2.5 rounded-xl border border-slate-200 bg-white focus:ring-2 focus:ring-primary outline-none text-sm">
                            </div>
                            <div>
                                <label class="block text-sm font-medium text-slate-700 mb-1">Tanggal Surat <span class="text-red-500">*</span></label>
                                <input type="date" id="cs-tgl" required class="w-full px-4 py-2.5 rounded-xl border border-slate-200 bg-white focus:ring-2 focus:ring-primary outline-none text-sm">
                            </div>
                        </div>
                        
                        <div>
                            <label class="block text-sm font-medium text-slate-700 mb-1">Keterangan / Perihal <span class="text-red-500">*</span></label>
                            <input type="text" id="cs-ket" required placeholder="Contoh: SK Pengangkatan Pengurus Baru" class="w-full px-4 py-2.5 rounded-xl border border-slate-200 bg-white focus:ring-2 focus:ring-primary outline-none text-sm">
                        </div>

                        <div>
                            <label class="block text-sm font-medium text-slate-700 mb-1">Link Dokumen (G-Drive / Publik) <span class="text-red-500">*</span></label>
                            <input type="url" id="cs-link" required placeholder="https://..." class="w-full px-4 py-2.5 rounded-xl border border-slate-200 bg-white focus:ring-2 focus:ring-primary outline-none text-sm">
                            <p class="text-xs text-slate-500 mt-1">Pastikan link dapat diakses publik agar penandatangan bisa membacanya.</p>
                        </div>

                        <div>
                            <label class="block text-sm font-medium text-slate-700 mb-2">Pilih Penandatangan <span class="text-red-500">*</span></label>
                            <div class="bg-slate-50 border border-slate-200 p-4 rounded-xl max-h-60 overflow-y-auto space-y-2" id="cs-pengurus-list">
                                <!-- Checkbox list di-generate via JS -->
                            </div>
                        </div>

                        <div class="pt-4 border-t border-slate-100 flex justify-end gap-3">
                            <button type="button" onclick="navigateAdmin('surat')" class="px-5 py-2.5 rounded-xl font-medium text-slate-600 bg-slate-100 hover:bg-slate-200">Batal</button>
                            <button type="submit" class="px-6 py-2.5 rounded-xl font-medium text-white bg-primary hover:bg-primaryDark shadow-md flex items-center gap-2">
                                <i class="fa-solid fa-paper-plane"></i> Proses Surat
                            </button>
                        </div>
                    </form>
                </div>

                <!-- View: Detail Surat -->
                <div id="view-surat-detail" class="admin-view hidden space-y-6">
                    <!-- Header -->
                    <div class="flex items-center gap-3">
                        <button onclick="navigateAdmin('surat')" class="w-10 h-10 flex items-center justify-center bg-white rounded-xl shadow-sm text-slate-500 hover:text-primary">
                            <i class="fa-solid fa-arrow-left"></i>
                        </button>
                        <h2 class="text-2xl font-bold text-slate-800">Detail Surat</h2>
                    </div>

                    <!-- Info Card -->
                    <div class="glass p-6 rounded-2xl">
                        <div class="flex justify-between items-start mb-4">
                            <div>
                                <span id="ds-status" class="px-3 py-1 rounded-full text-xs font-bold bg-orange-100 text-orange-600 mb-2 inline-block">Menunggu</span>
                                <h3 id="ds-no" class="font-bold text-xl text-slate-800">NO SURAT</h3>
                            </div>
                            <div class="flex gap-2">
                                <button onclick="openEditSurat()" class="bg-blue-100 text-blue-600 w-10 h-10 rounded-xl flex items-center justify-center hover:bg-blue-200 tooltip" title="Edit Surat">
                                    <i class="fa-solid fa-pen-to-square"></i>
                                </button>
                                <button onclick="deleteSurat()" class="bg-red-100 text-red-600 w-10 h-10 rounded-xl flex items-center justify-center hover:bg-red-200 tooltip" title="Hapus Surat">
                                    <i class="fa-solid fa-trash"></i>
                                </button>
                                <button onclick="showQRCode()" class="bg-slate-800 text-white w-10 h-10 rounded-xl flex items-center justify-center hover:bg-slate-700 tooltip" title="QR Code Validasi">
                                    <i class="fa-solid fa-qrcode"></i>
                                </button>
                                <button onclick="copyPublicVerifyLink()" class="bg-blue-100 text-blue-600 w-10 h-10 rounded-xl flex items-center justify-center hover:bg-blue-200 tooltip" title="Copy Link Validasi">
                                    <i class="fa-solid fa-link"></i>
                                </button>
                            </div>
                        </div>
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-sm text-slate-600">
                            <p><i class="fa-regular fa-calendar mr-2 w-4"></i> <span id="ds-tgl">Tanggal</span></p>
                            <p><i class="fa-solid fa-align-left mr-2 w-4"></i> <span id="ds-ket">Keterangan</span></p>
                            <p class="md:col-span-2"><i class="fa-solid fa-file-lines mr-2 w-4"></i> <a id="ds-link" href="#" target="_blank" class="text-primary hover:underline font-medium">Lihat Dokumen Asli</a></p>
                        </div>
                    </div>

                    <!-- Daftar Penandatangan -->
                    <h3 class="font-bold text-lg text-slate-800 mt-6 mb-3">Status Penandatangan</h3>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4" id="ds-ttd-list">
                        <!-- TTD Items injected by JS -->
                    </div>
                </div>

                <!-- View: Data Pengurus -->
                <div id="view-pengurus" class="admin-view hidden space-y-6">
                    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
                        <div>
                            <h2 class="text-2xl font-bold text-slate-800">Data Pengurus</h2>
                            <p class="text-slate-500">Kelola data penandatangan surat.</p>
                        </div>
                        <button onclick="openModalPengurus()" class="bg-primary text-white px-4 py-2 rounded-xl font-medium shadow-md hover:bg-primaryDark flex items-center justify-center gap-2">
                            <i class="fa-solid fa-user-plus"></i> Tambah Pengurus
                        </button>
                    </div>

                    <div class="glass p-4 rounded-2xl relative">
                        <i class="fa-solid fa-search absolute left-7 top-1/2 transform -translate-y-1/2 text-slate-400"></i>
                        <input type="text" id="search-pengurus" onkeyup="renderPengurusList()" placeholder="Cari Nama atau Jabatan..." class="w-full pl-12 pr-4 py-2 bg-slate-50 border border-slate-200 rounded-xl outline-none focus:ring-2 focus:ring-primary text-sm">
                    </div>

                    <div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
                        <div class="overflow-x-auto">
                            <table class="w-full text-left text-sm whitespace-nowrap">
                                <thead class="bg-slate-50 border-b border-slate-200 text-slate-600">
                                    <tr>
                                        <th class="px-6 py-4 font-medium">Nama Lengkap</th>
                                        <th class="px-6 py-4 font-medium">Jabatan / Divisi</th>
                                        <th class="px-6 py-4 font-medium">Kontak (WA)</th>
                                        <th class="px-6 py-4 font-medium text-right">Aksi</th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-slate-100" id="pengurus-table-body">
                                    <!-- List diisi via JS -->
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

            </div>
        </main>

        <!-- Mobile Bottom Nav -->
        <nav class="md:hidden glass-primary fixed bottom-0 left-0 w-full z-40 pb-safe">
            <div class="flex justify-around p-2">
                <a href="#" onclick="navigateAdmin('dashboard')" id="nav-mobile-dashboard" class="nav-item-mobile flex flex-col items-center p-2 rounded-xl text-slate-500 min-w-[64px]">
                    <i class="fa-solid fa-house text-xl mb-1"></i>
                    <span class="text-[10px] font-medium">Home</span>
                </a>
                <a href="#" onclick="navigateAdmin('surat')" id="nav-mobile-surat" class="nav-item-mobile flex flex-col items-center p-2 rounded-xl text-slate-500 min-w-[64px]">
                    <i class="fa-solid fa-file-signature text-xl mb-1"></i>
